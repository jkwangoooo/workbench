{
  "name": "teacher-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Teacher workbench TypeScript foundation with a legacy static prototype baseline.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-browser-deps.mjs",
    "dev": "npm run build && python3 -m http.server 4173",
    "format:check": "node tests/format-check.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:contracts": "node tests/typecheck.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "syntax": "node --check app.js",
    "check": "npm run format:check && npm run typecheck && npm run typecheck:contracts && npm test && npm run syntax"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
